@layout('layouts/main')

@section('content')
  <h1>{{ title }}</h1>
  <p class="lead">{{ lead }}</p>
  @if(posts && posts.length)
    @each(post in posts)
      <article class="post-card">
        <h2 class="h4">
          @if(detail)
            <a href="/posts/{{ post.id }}">{{ post.title }}</a>
          @else
            {{ post.title }}
          @endif
        </h2>
        <p class="text-muted mb-1">by {{ post.authorName }}</p>
        <p>{{ post.excerpt }}</p>
      </article>
    @endeach
  @else
    <p class="text-muted">No stories yet.</p>
  @endif
  @if(pagination)
    <nav class="d-flex gap-2 align-items-center">
      @if(pagination.prev)
        <a class="btn btn-sm btn-outline-secondary" href="/?page={{ pagination.prev }}@if(q)&q={{ q }}@endif">Prev</a>
      @endif
      <span>Page {{ pagination.page }} / {{ pagination.pages }}</span>
      @if(pagination.next)
        <a class="btn btn-sm btn-outline-secondary" href="/?page={{ pagination.next }}@if(q)&q={{ q }}@endif">Next</a>
      @endif
    </nav>
  @endif
@end
